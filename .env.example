# ==========================================
# Matrix Bot Configuration Example
# Copy this to .env and fill in the values
# ==========================================

# 1. Matrix Connection Config
MATRIX_HOMESERVER=https://matrix.org
MATRIX_USER_ID=@my_bot_user:matrix.org
# Provide either password OR access token. Access token is preferred for prod.
MATRIX_PASSWORD=my_secure_password
MATRIX_ACCESS_TOKEN=
MATRIX_DEVICE_ID=BOT_CLIENT

# 2. Database Configuration
# Dev SQLite: sqlite+aiosqlite:///data/bot.db
# Prod Postgres: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# 3. Third-party APIs & Feeds
GEMINI_API_KEY=your_gemini_api_key_for_nlp_and_rss_summaries
RSS_POLL_INTERVAL_SECONDS=3600
RSS_MIN_DELIVERY_INTERVAL_SECONDS=5
RSS_DEFAULT_CHANNEL=#sauna:pramari.de
# Summary mode (batched LLM digests). Uses GEMINI_API_KEY for authentication.
RSS_SUMMARY_INTERVAL_SECONDS=3600
RSS_SUMMARY_MODEL=gemini-3.5-flash-lite
RSS_SUMMARY_MAX_ARTICLES=20

# 4. Operations & Logging
LOG_LEVEL=INFO
JSON_LOGGING=false
HEALTH_PORT=8080
